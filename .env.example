SECRET=
SECRET_KEY=
DEBUG=true

HOST='127.0.0.1'
PORT=8000

EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
DEFAULT_FROM_EMAIL='d2dstore@gmail.com'

# Two-factor authentication (Fernet key, required when DEBUG=false)
MFA_ENCRYPTION_KEY=
MFA_ISSUER_NAME=D2DStore

# Comma separated. Leave empty for defaults: local addresses when DEBUG=true,
# .akimanaja.com / FRONTEND_URL / https://*.akimanaja.com when DEBUG=false
ALLOWED_HOSTS=
CORS_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Security headers and cookies. Leave empty to use the defaults: secure when DEBUG=false,
# off when DEBUG=true. Set a value only to override.
SH_SECONDS=
SHI_SUB_DOM=false
SCT_NOSNIFF=
S_SSL_REDIRECT=
S_C_SECURE=
CSRF_C_SECURE=
JWT_C_SECURE=
X_FRAME=
SH_PRELOAD=false

MYSQL_CONFIG=./db.cnf

DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=d2dstore_db

DB_BACKUP_ZONE=
DROPBOX_TOKEN=

GEOIP_PATH=
GEOIP_PATH=

FRONTEND_URL=http://localhost:3000
