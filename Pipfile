[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[dev-packages]
pylint = "==4.1.4"
pylint-django = "==2.8.0"
autopep8 = "==2.3.2"
django-upgrade = "==1.33.0"

[scripts]
start = "python manage.py runserver"
migrate = "python manage.py migrate"
manage = "python manage.py"
collectstatic = "python manage.py collectstatic --noinput"
createsuperuser = "python manage.py createsuperuser"
format = "autopep8 --in-place --recursive ."
format-check = "autopep8 --diff --exit-code --recursive ."
lint = "pylint apps app_utils d2dstore api"
graphql-schema = "python manage.py graphql_schema --schema d2dstore.schema.schema --out schema.graphql"

[packages]
django = "==5.2.19"
graphene-django = "==3.2.3"
django-graphql-jwt = "==0.4.0"
python-dotenv = "==1.2.4"
graphene = "==3.4.3"
djangorestframework = "==3.18.3"
django-cors-headers = "==4.9.0"
psycopg2 = "==2.9.13"
gunicorn = "==27.0.1"
django-dbbackup = "==5.4.1"
dropbox = "==12.2.5"
django-storages = "==1.14.6"
django-ipware = "==8.0.0"
pyjwt = "==2.15.1"
geoip2 = "==5.4.0"
django-crontab = "==0.7.1"
rich = "==15.0.0"
pyotp = "==2.12.1"
cryptography = "==50.0.2"
segno = "==1.6.6"

[requires]
python_version = "3.12"
